<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>SICE</display-name>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <filter>
        <filter-name>CSRFFilter</filter-name>
        <filter-class>filter.CSRFFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>CSRFFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/app/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/docente/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/app/examen-asignacion</url-pattern></filter-mapping>
    <servlet><servlet-name>LoginServlet</servlet-name><servlet-class>controller.LoginServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
    <servlet><servlet-name>LogoutServlet</servlet-name><servlet-class>controller.LogoutServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>LogoutServlet</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
    <servlet><servlet-name>DashboardServlet</servlet-name><servlet-class>controller.DashboardServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>DashboardServlet</servlet-name><url-pattern>/app/dashboard</url-pattern></servlet-mapping>
    <servlet><servlet-name>AlumnoServlet</servlet-name><servlet-class>controller.AlumnoServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AlumnoServlet</servlet-name><url-pattern>/app/alumnos</url-pattern></servlet-mapping>
    <servlet><servlet-name>DocenteServlet</servlet-name><servlet-class>controller.DocenteServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>DocenteServlet</servlet-name><url-pattern>/app/docentes</url-pattern></servlet-mapping>
    <servlet><servlet-name>GradoServlet</servlet-name><servlet-class>controller.GradoServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>GradoServlet</servlet-name><url-pattern>/app/grados</url-pattern></servlet-mapping>
    <servlet><servlet-name>SeccionServlet</servlet-name><servlet-class>controller.SeccionServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>SeccionServlet</servlet-name><url-pattern>/app/secciones</url-pattern></servlet-mapping>
    <servlet><servlet-name>CarreraServlet</servlet-name><servlet-class>controller.CarreraServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>CarreraServlet</servlet-name><url-pattern>/app/carreras</url-pattern></servlet-mapping>
    <servlet><servlet-name>AreaServlet</servlet-name><servlet-class>controller.AreaServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AreaServlet</servlet-name><url-pattern>/app/areas</url-pattern></servlet-mapping>
    <servlet><servlet-name>PeriodoServlet</servlet-name><servlet-class>controller.PeriodoServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>PeriodoServlet</servlet-name><url-pattern>/app/periodos</url-pattern></servlet-mapping>
    <servlet><servlet-name>DocenteAulaServlet</servlet-name><servlet-class>controller.DocenteAulaServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>DocenteAulaServlet</servlet-name><url-pattern>/app/docente-aula</url-pattern></servlet-mapping>
    <servlet><servlet-name>ExamenServlet</servlet-name><servlet-class>controller.ExamenServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ExamenServlet</servlet-name><url-pattern>/app/examenes</url-pattern></servlet-mapping>
    <servlet><servlet-name>ResultadoServlet</servlet-name><servlet-class>controller.ResultadoServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ResultadoServlet</servlet-name><url-pattern>/app/resultados</url-pattern></servlet-mapping>
    <servlet><servlet-name>RankingServlet</servlet-name><servlet-class>controller.RankingServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>RankingServlet</servlet-name><url-pattern>/app/ranking</url-pattern></servlet-mapping>
    <servlet><servlet-name>InscripcionServlet</servlet-name><servlet-class>controller.InscripcionServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>InscripcionServlet</servlet-name><url-pattern>/app/inscripciones</url-pattern></servlet-mapping>
    <servlet><servlet-name>PDFConstanciaServlet</servlet-name><servlet-class>controller.PDFConstanciaServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>PDFConstanciaServlet</servlet-name><url-pattern>/app/constancia-pdf</url-pattern></servlet-mapping>
    <session-config><session-timeout>30</session-timeout></session-config>
    <servlet><servlet-name>DocenteDashboardServlet</servlet-name><servlet-class>controller.DocenteDashboardServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>DocenteDashboardServlet</servlet-name><url-pattern>/docente/dashboard</url-pattern></servlet-mapping>
    <error-page><error-code>404</error-code><location>/views/shared/error404.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/views/shared/error500.jsp</location></error-page>
    <!-- Servlets de Estudiantes -->
    <servlet>
        <servlet-name>EstudianteLogoutServlet</servlet-name>
        <servlet-class>controller.EstudianteLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteLogoutServlet</servlet-name>
        <url-pattern>/estudiante/logout</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EstudianteLoginServlet</servlet-name>
        <servlet-class>controller.EstudianteLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteLoginServlet</servlet-name>
        <url-pattern>/estudiante/login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EstudianteRegistroServlet</servlet-name>
        <servlet-class>controller.EstudianteRegistroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteRegistroServlet</servlet-name>
        <url-pattern>/estudiante/registro</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EstudianteDashboardServlet</servlet-name>
        <servlet-class>controller.EstudianteDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteDashboardServlet</servlet-name>
        <url-pattern>/estudiante/dashboard</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EstudiantePDFConstanciaServlet</servlet-name>
        <servlet-class>controller.EstudiantePDFConstanciaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudiantePDFConstanciaServlet</servlet-name>
        <url-pattern>/estudiante/constancia-pdf</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EstudianteDiplomaServlet</servlet-name>
        <servlet-class>controller.EstudianteDiplomaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteDiplomaServlet</servlet-name>
        <url-pattern>/estudiante/diploma-pdf</url-pattern>
    </servlet-mapping>
    <servlet><servlet-name>ExamenAsignacionServlet</servlet-name><servlet-class>controller.ExamenAsignacionServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ExamenAsignacionServlet</servlet-name><url-pattern>/app/examen-asignacion</url-pattern></servlet-mapping>
    <servlet><servlet-name>UsuarioServlet</servlet-name><servlet-class>controller.UsuarioServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>UsuarioServlet</servlet-name><url-pattern>/app/usuarios</url-pattern></servlet-mapping>
    <servlet><servlet-name>AulaServlet</servlet-name><servlet-class>controller.AulaServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AulaServlet</servlet-name><url-pattern>/app/aulas</url-pattern></servlet-mapping>
    <servlet><servlet-name>EstudiantePerfilServlet</servlet-name><servlet-class>controller.EstudiantePerfilServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>EstudiantePerfilServlet</servlet-name><url-pattern>/estudiante/perfil</url-pattern></servlet-mapping>
    <servlet><servlet-name>ImportacionServlet</servlet-name><servlet-class>controller.ImportacionServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ImportacionServlet</servlet-name><url-pattern>/app/importar</url-pattern></servlet-mapping>
</web-app>